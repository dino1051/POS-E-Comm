// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoVenta {
  COMPLETADA
  CANCELADA
  DEVUELTA
  DEVUELTA_PARCIAL
}
enum EstadoWeb {
  PENDIENTE
  PAGADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum EstadoPagoWeb {
  PENDIENTE
  PAGADO
  RECHAZADO
  REEMBOLSADO
}

enum Pagos {
  EFECTIVO
  TARJETA
  TRANSFERENCIAQR
}

enum Role {
  ADMIN
  CAJERO
  CLIENTEWEB
}

enum EstadoSesionCaja {
  ABIERTA
  CERRADA
}

model User {
  id Int @id @default(autoincrement())
  nombre String 
  apellido String
  email String @unique
  password String
  direccion String?
  role Role @default(CLIENTEWEB)
  creadoEn DateTime @default(now())
  venta Ventas[]
  ventaWeb VentasWeb[]
  compras Compras[]
  sesioncaja SesionCaja[]

  @@map("users")
}

model Articulos {
  id Int @id @default(autoincrement())
  nombre String @unique
  id_categoria Int
  descripcion String?
  stock Int
  precioVenta Decimal @db.Decimal(10,2) @map("precio_venta")
  precioCompra Decimal @db.Decimal(10,2) @map("precio_compra")
  detallesventas DetallesVenta[]
  detallesventasweb DetallesVentaWeb[]
  detallescompras DetallesCompra[]
  categoria    Categorias @relation(fields: [id_categoria], references: [id])
  creadoEn DateTime @default(now())
  @@map("articulos")
}

model Categorias {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  articulos Articulos[]
  creadoEn DateTime @default(now())

  @@map("categorias")
}


model Ventas {
  id Int @id @default(autoincrement())
  fecha DateTime @default(now())
  total Decimal @db.Decimal(10,2)
  id_usuario Int 
  id_sesion_caja Int
  tipo_pago Pagos
  estado EstadoVenta @default(COMPLETADA)
  detallesVenta DetallesVenta[]
  devolucion Devoluciones[]
  sesionCaja SesionCaja @relation(fields: [id_sesion_caja],references: [id])
  usuario User @relation(fields:[id_usuario],references: [id])
  
  @@map("ventas")
}

model DetallesVenta {
  id Int @id @default(autoincrement())
  cantidadArticulos Int @map("cantidad_articulos")
  subtotal Decimal @db.Decimal(10,2)
  id_venta Int
  id_articulo Int
  cantidadDevuelta Int @default(0) @map("cantidad_devuelta")
  detallesDevolucion DetallesDevolucion[]
  venta Ventas @relation(fields: [id_venta],references: [id])
  articulo Articulos @relation(fields: [id_articulo], references: [id])

  @@map("detalles_venta")
}

model VentasWeb {
  id Int @id @default(autoincrement())
  fecha DateTime @default(now())
  total Decimal @db.Decimal(10,2)
  estadoweb EstadoWeb @default(PENDIENTE)
  estado_pago     EstadoPagoWeb @default(PENDIENTE)
  id_usuario Int
  id_pago_externo String?   @unique
  detallesventaweb DetallesVentaWeb[]
  usuario User @relation(fields:[id_usuario],references: [id])
  estado EstadoVenta @default(COMPLETADA)
  devolucion DevolucionesWeb[]


  @@map("ventas_web")
}

model DetallesVentaWeb {
  id Int @id @default(autoincrement())
  cantidadArticulos Int @map("cantidad_articulos")
  subtotal Decimal @db.Decimal(10,2)
  id_ventaweb Int
  id_articulo Int
  cantidadDevuelta Int @default(0) @map("cantidad_devuelta")
  devolucionesweb DetallesDevolucionWeb[]
  ventasweb VentasWeb @relation(fields: [id_ventaweb],references: [id])
  articulo Articulos @relation(fields: [id_articulo], references: [id])

  @@map("detalles_venta_web")
}

model Devoluciones {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  total       Decimal  @db.Decimal(10,2)
  id_venta    Int
  venta Ventas @relation(fields: [id_venta],references: [id])
  detalles DetallesDevolucion[]

  @@map("devoluciones")
}

model DetallesDevolucion {
  id Int      @id @default(autoincrement())
  cantidad Int
  subtotal Decimal  @db.Decimal(10,2)
  id_devolucion Int
  id_detalle_venta Int
  devolucion Devoluciones @relation(fields: [id_devolucion],references: [id])
  detalleVenta DetallesVenta @relation(fields: [id_detalle_venta],references: [id])

  @@map("detalles_devolucion")
}

model DevolucionesWeb {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  total       Decimal  @db.Decimal(10,2)
  id_ventaweb    Int
  ventaweb VentasWeb @relation(fields: [id_ventaweb],references: [id])
  detalles DetallesDevolucionWeb[]

  @@map("devolucionesweb")
}

model DetallesDevolucionWeb {
  id Int      @id @default(autoincrement())
  cantidad Int
  subtotal Decimal  @db.Decimal(10,2)
  id_devolucion Int
  id_detalle_venta Int
  devolucionweb DevolucionesWeb @relation(fields: [id_devolucion],references: [id])
  detalleVentaweb DetallesVentaWeb @relation(fields: [id_detalle_venta],references: [id])

  @@map("detalles_devolucion_web")
}

model Proveedores {
  id Int @id @default(autoincrement())
  nombre String
  email String
  telefono String
  compra Compras[]

  @@map("proveedores")
}

model Compras {
  id Int @id @default(autoincrement())
  fecha DateTime @default(now())
  total Decimal @db.Decimal(10,2)
  tipo_pago Pagos
  id_proveedor Int
  id_usuario Int
  detallescompra DetallesCompra[]

  proveedores Proveedores @relation(fields: [id_proveedor],references: [id])
  usuarios User @relation(fields: [id_usuario],references: [id])

  @@map("compras")
}

model DetallesCompra {
  id Int @id @default(autoincrement())
  cantidadArticulos Int @map("cantidad_articulos")
  subtotal Decimal @db.Decimal(10,2)
  id_compra Int
  id_articulo Int
  compras Compras @relation(fields: [id_compra],references: [id])
  articulo Articulos @relation(fields:[id_articulo],references: [id])
  @@map("detalles_compra")
}

model Pos {
  id Int @id @default(autoincrement())
  numero Int @unique
  nombre String?
  activo Boolean @default(true)

  sesionesCaja SesionCaja[]

  @@map("pos")
}

model SesionCaja {
  id Int @id @default(autoincrement())

  id_pos Int
  id_usuario_apertura Int

  fecha_apertura DateTime @default(now())
  monto_inicial Decimal @db.Decimal(10,2)

  fecha_cierre DateTime?
  monto_cierre Decimal? @db.Decimal(10,2)

  estado EstadoSesionCaja @default(ABIERTA)

  pos Pos @relation(fields: [id_pos], references: [id])
  usuario User @relation(fields: [id_usuario_apertura], references: [id])

  ventas Ventas[]

  @@map("sesiones_caja")
}