// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoVenta {
  COMPLETADA
  CANCELADA
  DEVUELTA
  DEVUELTA_PARCIAL
}
enum EstadoWeb {
  PENDIENTE
  PAGADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum Pagos {
  EFECTIVO
  TRAJETA
  TRANSFERENCIAQR
}

enum Role {
  ADMIN
  CAJERO
  CLIENTEWEB
}

model User {
  id Int @id @default(autoincrement())
  nombre String 
  apellido String
  email String @unique
  password String
  direccion String?
  role Role @default(CLIENTEWEB)
  creadoEn DateTime @default(now())
  venta Ventas[]
  ventaWeb VentasWeb[]
  compras Compras[]

  @@map("users")
}

model Articulos {
  id Int @id @default(autoincrement())
  nombre String @unique
  id_categoria Int
  descripcion String?
  stock Int
  precioVenta Decimal @db.Decimal(10,2) @map("precio_venta")
  precioCompra Decimal @db.Decimal(10,2) @map("precio_compra")
  detallesventas DetallesVenta[]
  detallesventasweb DetallesVentaWeb[]
  categoria    Categorias @relation(fields: [id_categoria], references: [id])
  creadoEn DateTime @default(now())
  @@map("articulos")
}

model Categorias {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  articulos Articulos[]
  creadoEn DateTime @default(now())

  @@map("categorias")
}


model Ventas {
  id Int @id @default(autoincrement())
  fecha DateTime @default(now())
  total Decimal @db.Decimal(10,2)
  id_usuario Int 
  tipo_pago Pagos
  detallesVenta DetallesVenta[]
  usuario User @relation(fields:[id_usuario],references: [id])
  estado EstadoVenta @default(COMPLETADA)
  devolucion Devoluciones[]
  @@map("ventas")
}

model DetallesVenta {
  id Int @id @default(autoincrement())
  cantidadArticulos Int @map("cantidad_articulos")
  subtotal Decimal @db.Decimal(10,2)
  id_venta Int
  id_articulo Int
  cantidadDevuelta Int @default(0) @map("cantidad_devuelta")
  detallesDevolucion DetallesDevolucion[]
  venta Ventas @relation(fields: [id_venta],references: [id])
  articulo Articulos @relation(fields: [id_articulo], references: [id])

  @@map("detalles_venta")
}

model VentasWeb {
  id Int @id @default(autoincrement())
  fecha DateTime @default(now())
  total Decimal @db.Decimal(10,2)
  estado EstadoWeb
  id_usuario Int
  detallesventaweb DetallesVentaWeb[]

  usuario User @relation(fields:[id_usuario],references: [id])

  @@map("ventas_web")
}

model DetallesVentaWeb {
  id Int @id @default(autoincrement())
  cantidadArticulos Int @map("cantidad_articulos")
  subtotal Decimal @db.Decimal(10,2)
  id_ventaweb Int
  id_articulo Int
  ventasweb VentasWeb @relation(fields: [id_ventaweb],references: [id])
  articulo Articulos @relation(fields: [id_articulo], references: [id])

  @@map("detalles_venta_web")
}

model Devoluciones {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  total       Decimal  @db.Decimal(10,2)
  id_venta    Int
  venta Ventas @relation(fields: [id_venta],references: [id])
  detalles DetallesDevolucion[]

  @@map("devoluciones")
}

model DetallesDevolucion {
  id Int      @id @default(autoincrement())
  cantidad Int
  subtotal Decimal  @db.Decimal(10,2)
  id_devolucion Int
  id_detalle_venta Int
  devolucion Devoluciones @relation(fields: [id_devolucion],references: [id])
  detalleVenta DetallesVenta @relation(fields: [id_detalle_venta],references: [id])

  @@map("detalles_devolucion")
}

model Proveedores {
  id Int @id @default(autoincrement())
  nombre String
  email String
  telefono String
  compra Compras[]

  @@map("proveedores")
}

model Compras {
  id Int @id @default(autoincrement())
  fecha DateTime @default(now())
  total Decimal @db.Decimal(10,2)
  tipo_pago Pagos
  id_proveedor Int
  id_usuario Int
  detallescompra DetallesCompra[]

  proveedores Proveedores @relation(fields: [id_proveedor],references: [id])
  usuarios User @relation(fields: [id_usuario],references: [id])

  @@map("compras")
}

model DetallesCompra {
  id Int @id @default(autoincrement())
  cantidadArticulos Int @map("cantidad_articulos")
  subtotal Decimal @db.Decimal(10,2)
  id_compra Int

  compras Compras @relation(fields: [id_compra],references: [id])

  @@map("detalles_compra")
}